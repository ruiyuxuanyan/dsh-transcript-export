{
  "name": "dsh-session-share",
  "version": "0.2.0",
  "description": "DeepSeek Harness 会话导出与分享插件:在每条助手回复的操作栏里一键把对话导出成干净的 Markdown / 单文件 HTML / JSON,支持从所选消息向前回溯 N 轮、工具调用折叠、密钥脱敏、目录与代码高亮,不改动原始会话日志。Conversation export & share for DeepSeek Harness: export transcripts as clean Markdown, self-contained HTML, or JSON from any assistant message, with turn ranges, tool-call folding, secret redaction and an optional searchable library.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "client-plugin",
    "export",
    "markdown",
    "html",
    "share",
    "transcript",
    "conversation"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test test/core.test.mjs test/host.test.mjs",
    "index": "node scripts/make-index.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
